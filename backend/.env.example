# Database Configuration
# The password for the PostgreSQL container (veritas_app user)
POSTGRES_PASSWORD=your_secure_postgres_password_here

# JWT Security Configuration
# SECURITY_JWT_SECRET_BASE64 must be a Base64-encoded string representing at least 32 bytes (256 bits) for HMAC-SHA256.
# Generation examples:
#   PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
#   Bash: openssl rand -base64 32
SECURITY_JWT_SECRET_BASE64=your_base64_encoded_256_bit_secret_here

# JWT expiration in milliseconds (e.g. 86400000 for 24 hours, 900000 for 15 minutes)
SECURITY_JWT_EXPIRATION_MS=86400000
